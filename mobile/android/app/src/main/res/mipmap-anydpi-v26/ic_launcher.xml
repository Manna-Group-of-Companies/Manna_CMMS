<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (API 26+). Devices below that fall back to the
     ic_launcher.png in the mipmap-* density folders. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <!-- Android 13+ themed icons: the launcher tints the glyph to the user's
         wallpaper palette, so the same white-on-transparent layer is reused. -->
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>

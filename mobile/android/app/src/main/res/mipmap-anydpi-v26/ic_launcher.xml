<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (API 26+). Devices below that fall back to the
     ic_launcher.png in the mipmap-* density folders. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <!--
      No <monochrome>. Android 13+ themed icons flatten whatever they are given
      to a single wallpaper colour, and the Manna mark is two colours and a
      registered wordmark: flattened it reads as a smudge. Without this element
      the launcher keeps showing the real icon instead.
    -->
</adaptive-icon>

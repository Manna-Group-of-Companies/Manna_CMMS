<?xml version="1.0" encoding="utf-8"?>
<!-- The CMMS mark as a standalone, self-contained logo: translucent white tile plus
     white glyph. Unlike ic_launcher_foreground this one draws its own
     background, because nothing masks or backs it when it is used on the
     launch screen. The glyph is scaled to ~62% of the tile, matching the
     proportion of the web favicon in client/public/favicon.svg.

     The mark (23 Oct 2026): a solid gear with a wrench cut through it, the
     same as the favicon and lib's assets/brand/cmms_mark.png. A vector cannot
     cut a hole through a fill, so the wrench is drawn in the colour the tile
     shows over the launch background: launch_background (#D14A0C) under the
     tile's 18% white, which is #D96B38. Change it if either of those changes. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#2EFFFFFF"
        android:pathData="M24,0h60a24,24 0 0 1 24,24v60a24,24 0 0 1 -24,24h-60a24,24 0 0 1 -24,-24v-60a24,24 0 0 1 24,-24z" />
    <group
        android:pivotX="0"
        android:pivotY="0"
        android:scaleX="2.8"
        android:scaleY="2.8"
        android:translateX="20.4"
        android:translateY="20.4">
        <!-- The gear, filled. -->
        <path
            android:fillColor="#FFFFFF"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="1.2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M12.22,2h-0.44a2,2 0 0 0 -2,2v0.18a2,2 0 0 1 -1,1.73l-0.43,0.25a2,2 0 0 1 -2,0l-0.15,-0.08a2,2 0 0 0 -2.73,0.73l-0.22,0.38a2,2 0 0 0 0.73,2.73l0.15,0.1a2,2 0 0 1 1,1.72v0.51a2,2 0 0 1 -1,1.74l-0.15,0.09a2,2 0 0 0 -0.73,2.73l0.22,0.38a2,2 0 0 0 2.73,0.73l0.15,-0.08a2,2 0 0 1 2,0l0.43,0.25a2,2 0 0 1 1,1.73V20a2,2 0 0 0 2,2h0.44a2,2 0 0 0 2,-2v-0.18a2,2 0 0 1 1,-1.73l0.43,-0.25a2,2 0 0 1 2,0l0.15,0.08a2,2 0 0 0 2.73,-0.73l0.22,-0.39a2,2 0 0 0 -0.73,-2.73l-0.15,-0.08a2,2 0 0 1 -1,-1.74v-0.5a2,2 0 0 1 1,-1.74l0.15,-0.09a2,2 0 0 0 0.73,-2.73l-0.22,-0.38a2,2 0 0 0 -2.73,-0.73l-0.15,0.08a2,2 0 0 1 -2,0l-0.43,-0.25a2,2 0 0 1 -1,-1.73V4a2,2 0 0 0 -2,-2z" />
        <!-- The wrench through it, at 60% about the gear's centre. -->
        <group
            android:pivotX="0"
            android:pivotY="0"
            android:scaleX="0.6"
            android:scaleY="0.6"
            android:translateX="4.8"
            android:translateY="4.8">
            <path
                android:strokeColor="#D96B38"
                android:strokeWidth="3.6"
                android:strokeLineCap="round"
                android:strokeLineJoin="round"
                android:pathData="M14.7,6.3a1,1 0 0 0 0,1.4l1.6,1.6a1,1 0 0 0 1.4,0l3.77,-3.77a6,6 0 0 1 -7.94,7.94l-6.91,6.91a2.12,2.12 0 0 1 -3,-3l6.91,-6.91a6,6 0 0 1 7.94,-7.94l-3.76,3.76z" />
        </group>
    </group>
</vector>

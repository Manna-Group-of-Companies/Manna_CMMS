<?xml version="1.0" encoding="utf-8"?>
<!-- Shown by LaunchTheme while the Flutter engine boots, and behind the UI
     afterwards. AppColors.canvas, so it hands over to the Dart side without a
     flash of a different background. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />

    <item
        android:drawable="@drawable/ic_brand_mark"
        android:gravity="center"
        android:width="96dp"
        android:height="96dp" />
</layer-list>

# ---------------------------------------------------------------------------
# Manna CMMS - client (Vite) environment
# ---------------------------------------------------------------------------
# Only variables prefixed with VITE_ are exposed to the browser.
# They are BAKED INTO THE BUNDLE AT BUILD TIME and are publicly readable,
# so never put secrets (JWT_SECRET, MONGO_URI, API keys) in this file.
#
# Load order (later files win):
#   .env  ->  .env.development (npm run dev)  |  .env.production (npm run build)
#   Host-level env vars (Netlify / Vercel / Render) override everything.
# ---------------------------------------------------------------------------

# Base URL of the backend API. Must include the /api suffix and no trailing slash.
VITE_API_URL=https://cmms-0qbj.onrender.com/api

# Alternatives - uncomment one to switch targets:
# VITE_API_URL=http://localhost:5000/api          # local backend
# VITE_API_URL=http://192.168.1.10:5000/api       # backend on the LAN

node_modules/
.env

# Spreadsheet exports and the catalog derived from them. Operational data, not
# code: the ledger export carries the store's movement history and the names of
# the supervisors who handled each one, which does not belong in the repository.
# scripts/extractProductsFromTransactions.js rebuilds everything here from a
# fresh export.
data/

# The ERPNext import sheets, for the same reason: they carry the whole catalog
# and every current shelf balance. scripts/exportForErpnext.js regenerates them
# from the database whenever they are needed.
exports/
# Credentials copied aside during a key rotation. Never in the repo.
.env.backup*
.env.*.local

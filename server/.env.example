# Copy to .env and fill in real values. .env is gitignored - never commit secrets.

PORT=5000

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/stockmaster

# Secret used to sign JWTs. Use a long random value in production.
JWT_SECRET=change_me

# Deployed client URL(s) allowed to call this API (comma separated).
# localhost:5173 / :4173 are always allowed, no need to list them here.
CORS_ORIGINS=https://cmms.odd-wind-70a0.workers.dev

# When the weekly Red Stock merge request is raised for the Admin to approve.
# Day is 0=Sunday..6=Saturday, hour is 0-23, both in the server's timezone.
# An Admin can always raise it early from the Weekly Merge screen.
WEEKLY_MERGE_ENABLED=true
WEEKLY_MERGE_DAY=1
WEEKLY_MERGE_HOUR=9

# Copy to .env and fill in real values. .env is gitignored - never commit secrets.

PORT=5000

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/stockmaster

# Secret used to sign JWTs. Use a long random value in production.
JWT_SECRET=change_me

# Extra client URL(s) allowed to call this API (comma separated).
# localhost:5173 / :4173 and the Cloudflare Pages client (including its preview
# subdomains) are always allowed in code, so this is only for anything on top —
# a custom domain, or a client hosted somewhere else.
CORS_ORIGINS=https://mannagroupcmms.pages.dev

# When the weekly Red Stock merge request is raised for the Admin to approve.
# Day is 0=Sunday..6=Saturday, hour is 0-23, both in the server's timezone.
# An Admin can always raise it early from the Weekly Merge screen.
WEEKLY_MERGE_ENABLED=true
WEEKLY_MERGE_DAY=1
WEEKLY_MERGE_HOUR=9

# --- ERPNext -----------------------------------------------------------
# The sync stays off unless ERPNEXT_SYNC_ENABLED is exactly "true" AND all
# three settings below are filled in. Module 1 works without any of this.
#
# The key and secret belong to a dedicated integration account, not to a
# person. Generate them in ERPNext under the user's "API Access" section.
# They are read only by this server — never put them in the client or the
# mobile app, where they would be readable by anyone with the bundle.
ERPNEXT_SYNC_ENABLED=false
ERPNEXT_URL=https://mannarubber.m.frappe.cloud
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=

# How often the worker looks for queued movements, in milliseconds.
ERPNEXT_POLL_MS=15000

# How many times a movement is retried before it is left for an Admin. Only
# retryable failures count against this; a document ERPNext rejects outright
# is failed immediately rather than tried six times.
ERPNEXT_MAX_ATTEMPTS=6

# The nightly comparison of CMMS balances against ERPNext, which is what
# catches a movement that failed to post without anybody noticing. Follows
# ERPNEXT_SYNC_ENABLED, so it only runs once the sync is on. Set to "false" to
# suppress it. Hour is 0-23 in the server's timezone.
ERPNEXT_DRIFT_ENABLED=true
ERPNEXT_DRIFT_HOUR=2
